@baseUrl = http://localhost:3000/api

### GET all courses -- expect 200
GET {{baseUrl}}/courses

### GET one course by id -- expect 200
GET {{baseUrl}}/courses/1

### GET a course that does not exist -- expect 404
GET {{baseUrl}}/courses/9999

### POST -- create a new course -- expect 201
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "title": "Cloud Computing",
  "number": "CSC4600",
  "description": "Test Course",
  "credits": 3,
  "prerequisites": [5, 9]
}

### POST -- create a new course bad input -- expect 400
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "title": "Cloud Computing",
  "description": "Test Course",
  "prerequisites": [5, 9]
}

### PUT -- update the course created
PUT {{baseUrl}}/courses/11
Content-Type: application/json

{
  "title": "Cloud Computing",
  "number": "CSC4600",
  "description": "testing Course",
  "credits": 3,
  "prerequisites": [5,9]
}

### DELETE -- remove a course
DELETE {{baseUrl}}/courses/11

### Confirm the delete -- expect 404
GET {{baseUrl}}/courses/11

### POST missing required field -- expect 400
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "title": "Incomplete Course"
}

### GET completions -- expect 200
GET {{baseUrl}}/completions

### PUT update completions -- expect 200
PUT {{baseUrl}}/completions
Content-Type: application/json

[
  {
    "user_id": 1,
    "course_id": 1
  },
  {
    "user_id": 1,
    "course_id": 3
  },
  {
    "user_id" : 1,
    "course_id" : 2
  }
]

### PUT update completions breaks prereq -- expect 400
PUT {{baseUrl}}/completions
Content-Type: application/json

[
  {
    "user_id": 1,
    "course_id": 1
  },
  {
    "user_id": 1,
    "course_id": 3
  },
  {
    "user_id" : 1,
    "course_id" : 10
  }
]